# Copy this file to .env for local use:  cp .env.example .env
# Never commit .env or real secrets to Git.

PROJECT_NAME=SmartPark Maroc
APP_ENV=development

# Paths (relative to the project root)
DATA_RAW_DIR=data/raw
DATA_PROCESSED_DIR=data/processed
DETECTION_MODEL_PATH=models/plate_detector.pt
OCR_MODEL_PATH=models/plate_ocr.pt

# Detection settings (CPU only)
DEVICE=cpu
DETECTION_CONFIDENCE=0.25
DETECTION_IOU=0.45

# FastAPI settings
API_HOST=127.0.0.1
API_PORT=8000

# Streamlit settings
STREAMLIT_SERVER_PORT=8501

# Logging
LOG_LEVEL=INFO
